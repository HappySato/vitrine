# LLM inference
# Leave LLM_BASE_URL empty to use the local planner (no GPU, no key).
# Set LLM_BACKEND=amd-mi300x only when this URL is vLLM on an AMD Instinct MI300X.
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=
LLM_BACKEND=auto
LLM_TIMEOUT_MS=60000
LLM_FALLBACK=on

# Taste provider: mock | qloo
# qloo without QLOO_API_KEY stays on the local taste graph.
TASTE_PROVIDER=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Payment provider: mock | paypal-sandbox
# Orders are never captured. A live PayPal host is refused.
PAYMENT_PROVIDER=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
